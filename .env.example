# 复制本文件为 .env（在项目根目录），填入你的 key：
#   copy .env.example .env
#
# .env 已被 .gitignore 忽略，不会被提交到 git。

# ── Azure AI Foundry - gpt-5-mini（推荐）──────────────────────────────────
OPENAI_API_KEY=your-azure-foundry-api-key
OPENAI_BASE_URL=https://your-foundry.services.ai.azure.com/openai/v1
OPENAI_MODEL=gpt-5-mini
# gpt-5 系列拒绝 temperature 字段，设为 none 自动省略
OPENAI_TEMPERATURE=none
# 可选：限制每次调用最大输出 token（gpt-5-mini 支持 max_completion_tokens）
# OPENAI_MAX_COMPLETION_TOKENS=8192

# ── 其它兼容端点示例（任选其一，取消注释即可）────────────────────────────
# OpenAI 官方
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.4

# DeepSeek
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_TEMPERATURE=0.4

# 本地 Ollama
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_TEMPERATURE=0.4

# ── Seismic LLMG 模式（可选；同时设置 LLMG_BASE_URL 与 LLMG_TOKEN 即启用，覆盖上面的 OPENAI_*）──
# 请求发往 {LLMG_BASE_URL}/v1/chat/completions。QA 基址形式（来自笔记，未验证）：
#   https://gateway-qa-az-westus-wombat.seismic-dev.com/llmg
# LLMG_BASE_URL=
# 委托令牌（scope aiml_llm，约 30 分钟过期，需手动获取并重新填写）；只放 .env / 环境变量，不要提交
# LLMG_TOKEN=
# 或把令牌写进文件（不提交）：LLMG_TOKEN_FILE=C:\path\to\llmg_token.txt
# LLMG_FEATURE_ID=demo
# LLMG 模型 id（不是 Azure 部署名），如 gpt-5-mini-2025-08-07 / gpt-5.4-2026-03-05
# LLMG_MODEL=gpt-5-mini-2025-08-07
