# 复制本文件为 .env（在项目根目录，即本文件同目录），填入你的 key：
#   copy .env.example .env
#
# .env 已被 .gitignore 忽略，不会被提交到 git。
# 项目启动时会自动读取 .env（无需改系统环境变量）；
# 若系统环境变量已存在同名变量，则优先用系统环境变量。

# DeepSeek（默认 OpenAI 兼容端点，也可换成其它兼容服务）
OPENAI_API_KEY=sk-在此填写你的DeepSeekKey
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 其它兼容端点示例（任选其一，取消注释即可）：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1      # 本地 Ollama
# OPENAI_MODEL=llama3.1
